{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "lib": ["ES2022"],
    "types": ["vite/client"],
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["vite.config.ts"]
}
